<ui version="4.0">
 <class>DutchmanPrefs</class>
 <widget class="QWidget" name="DutchmanPrefs">
  <property name="windowTitle"><string>Import settings</string></property>
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0"><widget class="QLabel" name="binaryLabel"><property name="text"><string>Dutchman program</string></property></widget></item>
   <item row="0" column="1"><widget class="Gui::PrefFileChooser" name="binaryPath">
    <property name="toolTip"><string>Path to the dutchman executable. Leave empty to use DUTCHMAN_BIN, your PATH, or the copy this addon downloaded.</string></property>
    <property name="prefEntry" stdset="0"><cstring>BinaryPath</cstring></property>
    <property name="prefPath" stdset="0"><cstring>Mod/Dutchman</cstring></property>
   </widget></item>
   <item row="1" column="0" colspan="2"><widget class="QLabel" name="binaryHint">
    <property name="text"><string>Leave empty to use the copy found on your PATH or downloaded by this addon.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
   <item row="2" column="0" colspan="2"><widget class="Gui::PrefCheckBox" name="autoDownload">
    <property name="text"><string>Offer to download Dutchman when it is missing (asks before contacting GitHub)</string></property>
    <property name="checked"><bool>true</bool></property>
    <property name="prefEntry" stdset="0"><cstring>AutoDownload</cstring></property>
    <property name="prefPath" stdset="0"><cstring>Mod/Dutchman</cstring></property>
   </widget></item>
   <item row="3" column="0"><widget class="QLabel" name="outputLabel"><property name="text"><string>Save a FreeCAD copy to</string></property></widget></item>
   <item row="3" column="1"><widget class="Gui::PrefFileChooser" name="outputFolder">
    <property name="mode"><enum>Gui::FileChooser::Directory</enum></property>
    <property name="toolTip"><string>After each import, also save the document as a .FCStd file in this folder. Leave empty to save nothing.</string></property>
    <property name="prefEntry" stdset="0"><cstring>OutputFolder</cstring></property>
    <property name="prefPath" stdset="0"><cstring>Mod/Dutchman</cstring></property>
   </widget></item>
   <item row="4" column="0" colspan="2"><widget class="QLabel" name="outputHint">
    <property name="text"><string>After every import a .FCStd copy of the document is saved in this folder. Leave empty to save nothing.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
   <item row="5" column="0" colspan="2"><widget class="QLabel" name="downloadNotice">
    <property name="text"><string>Downloads contact GitHub for release metadata, checksums, and the archive for your OS. CAD files and conversion reports are never uploaded by the addon.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget><class>Gui::PrefFileChooser</class><extends>QWidget</extends><header>Gui/PrefWidgets.h</header></customwidget>
  <customwidget><class>Gui::PrefCheckBox</class><extends>QCheckBox</extends><header>Gui/PrefWidgets.h</header></customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
